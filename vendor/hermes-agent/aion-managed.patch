+        )
+        path_schema = (
+            function.get("parameters", {}).get("properties", {}).get("path")
+        )
+        if isinstance(path_schema, dict):
+            original = str(path_schema.get("description") or "Path")
+            path_schema["description"] = f"{original}. {root_guidance}"
+        tools[index] = scoped_schema
+    agent.tools = tools
+
