+def _bind_acp_workspace(agent: Any, cwd: str) -> None:
+    """Put the editor workspace next to the task and in each file-tool schema.
+
+    ``model_tools`` memoizes tool definitions and returns shared schema dicts.
+    Keep pristine per-agent copies so concurrent ACP sessions never leak one
+    workspace path into another session's model request.
+    """
+    workspace_root = str(cwd)
+    encoded_root = json.dumps(workspace_root, ensure_ascii=False)
+    workspace_prompt = (
+        "# ACP workspace\n"
+        f"workspace_root is already provided: {encoded_root}\n"
+        "Resolve every relative file path against workspace_root. When the user "
+        "asks to find or read a file, call search_files or read_file before "
+        "answering. Do not ask for the workspace root while workspace_root is "
+        "available."
+    )
+
+    if not hasattr(agent, "_aion_acp_base_ephemeral_prompt"):
+        agent._aion_acp_base_ephemeral_prompt = getattr(
+            agent, "ephemeral_system_prompt", None
+        )
+    base_prompt = agent._aion_acp_base_ephemeral_prompt
+    agent.ephemeral_system_prompt = (
+        f"{base_prompt}\n\n{workspace_prompt}" if base_prompt else workspace_prompt
+    )
+
+    tools = getattr(agent, "tools", None)
+    if not isinstance(tools, list):
+        return
+    if not hasattr(agent, "_aion_acp_base_file_tool_schemas"):
+        agent._aion_acp_base_file_tool_schemas = {
+            tool.get("function", {}).get("name"): copy.deepcopy(tool)
+            for tool in tools
+            if isinstance(tool, dict)
+            and tool.get("function", {}).get("name") in _ACP_WORKSPACE_FILE_TOOLS
+        }
+
+    base_schemas = agent._aion_acp_base_file_tool_schemas
+    for index, tool in enumerate(tools):
+        if not isinstance(tool, dict):
+            continue
+        name = tool.get("function", {}).get("name")
+        base_schema = base_schemas.get(name)
+        if base_schema is None:
+            continue
+        scoped_schema = copy.deepcopy(base_schema)
+        function = scoped_schema["function"]
+        root_guidance = (
+            f"workspace_root: {encoded_root}. Relative paths are supported and "
+            "are resolved against workspace_root."
+        )
+        function["description"] = (
